{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "minilytics",
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-09-01",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none",
    // Static files skip the Worker. Anything else (client routes, unknown paths) runs it so missing pages return a real 404.
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "minilytics",
      // Replace with the id printed by `npx wrangler d1 create minilytics`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
  // Optional, extra protection against floods (the login lockout works without it). Uncomment to turn floods away
  // before they cost a database read or write. Limits are per Cloudflare location, so approximate.
  // ,"ratelimits": [
  //   { "name": "LOGIN_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 10 } },
  //   { "name": "EVENT_LIMITER", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } }
  // ]
}
