{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "minilytics",
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none",
    // Static files skip the Worker. Anything else (client routes, unknown paths) runs it so missing pages return a real 404.
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "minilytics",
      "database_id": "98b97d28-a119-4d85-870e-89d7c1b9fbe7",
      "migrations_dir": "migrations"
    }
  ]
}
