# Secrets. Copy to .dev.vars for local dev; the Deploy to Cloudflare button asks for each one.
ADMIN_EMAIL=you@example.com # the email you'll log in with
ADMIN_PASSWORD=change-me # the password you'll log in with
# ALLOW_SIGNUP=true # optional: let anyone create an account (each sees only its own sites)
SESSION_SECRET=any-long-random-string # signs the login cookie; openssl rand -hex 32
